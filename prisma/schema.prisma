// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(ulid())
  fullName       String
  email          String    @unique
  password       String
  avatar         Image[]
  location       String?
  phone          String?
  idCard         String?
  roleId         String
  role           Role      @relation(fields: [roleId], references: [id])
  isActive       Boolean   @default(false)
  lastLoginAt    DateTime?
  lastActivityAt DateTime?
  statusId       String?
  status         Status?   @relation(fields: [statusId], references: [id])
  createdAt      DateTime  @default(now())
  booking        Booking[]
  ratings        Rating[]
  otps           OTP[]
}

model OTP {
  id        String   @id @default(uuid())
  code      String   @unique
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  type      OTPType  @default(SIGNUP)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

enum OTPType {
  SIGNUP
  RECOVER
}

model Motorbike {
  id              String    @id @default(ulid())
  name            String
  slug            String
  brand           String
  model           String
  year            Int
  licensePlateNum String    @unique
  color           String?
  images          Image[]
  engineCapacity  Int
  fuelType        String
  consume         String?
  fuelCapacity    String?
  weight          Int
  pricePerDay     Float
  description     String
  odoNum          Float
  seat            Int       @default(2)
  situation       String?
  isReady         Boolean   @default(false)
  maintenanceAt   DateTime?
  statusId        String
  status          Status    @relation(fields: [statusId], references: [id])
  createdAt       DateTime  @default(now())
  bookings        Booking[]
  ratings         Rating[]
}

model Booking {
  id            String         @id @default(ulid())
  motorbikeId   String
  motorbike     Motorbike      @relation(fields: [motorbikeId], references: [id])
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  pickupDate    DateTime
  returnDate    DateTime
  pickupPoint   String
  returnPoint   String
  coupon        String?
  isCouponUsed  Boolean        @default(false)
  isHelmet      Boolean        @default(true)
  isScratch     Boolean        @default(false)
  isRaincoat    Boolean        @default(false)
  statusId      String
  status        Status         @relation(fields: [statusId], references: [id])
  price         Float
  createdAt     DateTime       @default(now())
  customerInfo  CustomerInfo[]
  notifications Notification[]
  rating        Rating?
}

model CustomerInfo {
  id        String   @id @default(ulid())
  fullName  String
  phone     String
  email     String
  idCard    String
  note      String?
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id])
  createdAt DateTime @default(now())
}

model Rating {
  id          String    @id @default(ulid())
  rating      Int
  review      String?
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  motorbikeId String
  motorbike   Motorbike @relation(fields: [motorbikeId], references: [id])
  bookingId   String    @unique
  booking     Booking   @relation(fields: [bookingId], references: [id])
  statusId    String
  status      Status    @relation(fields: [statusId], references: [id])
  isPublic    Boolean   @default(false)
  feedback    String?
  createdAt   DateTime  @default(now())

  notifications Notification[]
}

model Notification {
  id        String           @id @default(ulid())
  type      NotificationType
  bookingId String?
  booking   Booking?         @relation(fields: [bookingId], references: [id])
  ratingId  String?
  rating    Rating?          @relation(fields: [ratingId], references: [id])
  isRead    Boolean          @default(false)
  isNew     Boolean          @default(true)
  createdAt DateTime         @default(now())
}

enum NotificationType {
  BOOKING
  RATING
}

model Status {
  id         String      @id @default(ulid())
  name       String      @unique
  createdAt  DateTime    @default(now())
  motorbikes Motorbike[]
  bookings   Booking[]
  users      User[]
  ratings    Rating[]
}

model Coupon {
  id          String    @id @default(ulid())
  code        String
  description String
  discount    Float
  forNewUser  Boolean
  forMember   Boolean   @default(false)
  isPublic    Boolean
  expiredAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Image {
  id          String     @id @default(ulid())
  url         String     @unique
  createdAt   DateTime   @default(now())
  userId      String?
  user        User?      @relation(fields: [userId], references: [id])
  motorbikeId String?
  motorbike   Motorbike? @relation(fields: [motorbikeId], references: [id])
}

model Role {
  id        String   @id @default(ulid())
  name      String   @unique
  createdAt DateTime @default(now())
  users     User[]
}
